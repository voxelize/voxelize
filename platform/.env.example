# Copy to .env and fill in. Generate secrets with e.g. `openssl rand -hex 32`.
HTTP_PORT=8080

# Laravel: `php artisan key:generate --show` (or base64:<32 random bytes>)
APP_KEY=

MYSQL_ROOT_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_PASSWORD=
# The game servers' MySQL account (player records only).
GAME_DB_PASSWORD=

MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=

# Game tickets: comma-separated, newest first, each >= 32 bytes. The API
# signs with the first; game servers accept all (key rotation).
GAME_TICKET_SECRETS=
# Secret bridge/transport connections present to the game server (>= 32 bytes).
GAME_TRANSPORT_SECRET=
# Game servers present this to the backend's internal API (land feed);
# at least 32 random bytes, e.g. `openssl rand -hex 32`.
GAME_SERVICE_TOKEN=

GAME_WORLD_SEED=20260101
GAME_PRELOAD_RADIUS=3

# Email for password resets and address confirmation (SMTP). Leave the
# defaults to use the "mail" profile's Mailpit in development.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Where links in emails open the game (your public address).
PLATFORM_CLIENT_URL=
# true: accounts must confirm their address before playing.
AUTH_REQUIRE_VERIFIED_EMAIL=false

# Voice relay (`docker compose --profile voice up`): a shared secret of 32+
# characters, this host's public IP, and the addresses players connect to.
TURN_SECRET=
TURN_EXTERNAL_IP=
GAME_TURN_URLS=
