# Copy to .env and fill in. Generate secrets with e.g. `openssl rand -hex 32`.
HTTP_PORT=8080

# Laravel: `php artisan key:generate --show` (or base64:<32 random bytes>)
APP_KEY=

MYSQL_ROOT_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_PASSWORD=

MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=

# Game tickets: comma-separated, newest first, each >= 32 bytes. The API
# signs with the first; game servers accept all (key rotation).
GAME_TICKET_SECRETS=
# Secret bridge/transport connections present to the game server (>= 32 bytes).
GAME_TRANSPORT_SECRET=

GAME_WORLD_SEED=20260101
GAME_PRELOAD_RADIUS=3
