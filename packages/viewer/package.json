{
  "name": "@voxelize/viewer",
  "version": "3.0.0",
  "license": "MIT",
  "description": "Fly over a Voxelize world without joining it: chunk and far-tile streaming with the engine's own meshing and materials, overlays, A/B sources, and a scriptable capture CLI",
  "type": "module",
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "bin": {
    "voxelize-viewer": "./bin/voxelize-viewer.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "types": "tsc --noEmit -p ./tsconfig.json",
    "demo": "tsx bin/voxelize-viewer.ts --config demo/config.ts serve --idle-ttl 0",
    "demo:shot": "tsx bin/voxelize-viewer.ts --config demo/config.ts shot --bookmark overview"
  },
  "dependencies": {
    "@voxelize/core": "workspace:*",
    "esbuild": "^0.21.5",
    "puppeteer": "^23.11.1"
  },
  "peerDependencies": {
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
